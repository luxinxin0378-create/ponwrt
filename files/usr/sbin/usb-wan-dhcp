#!/bin/sh
# usb-wan-dhcp —— 为 USB 网卡（RNDIS / ECM / NCM）自动建立 DHCP 接口
#
# 背景：QModem 3.x 的模块识别表（/usr/share/qmodem/modem_port_rule.json）
#       未收录 Fibocom NL668 等模块，导致 RNDIS/ECM 模式下无法自动建接口。
#       本脚本不依赖任何 VID/PID 白名单，直接按内核驱动类型识别，
#       因此对任意 RNDIS/ECM/NCM 模块都有效。
#
# 触发：/etc/init.d/usbwan（开机） + /etc/hotplug.d/net/50-usb-wan（热插拔）

LOG_TAG="usb-wan-dhcp"
log() { logger -t "$LOG_TAG" "$*" 2>/dev/null; }

# 判断是否为我们关心的 USB 网卡
is_usb_net() {
    local dev="$1" drv
    [ -n "$dev" ] || return 1
    [ -e "/sys/class/net/$dev/device" ] || return 1
    drv=$(basename "$(readlink -f "/sys/class/net/$dev/device/driver" 2>/dev/null)" 2>/dev/null)
    case "$drv" in
        rndis_host|cdc_ether|cdc_ncm|huawei_cdc_ncm) return 0 ;;
    esac
    return 1
}

# 该网卡是否已被某个 network 接口占用
dev_bound() {
    local dev="$1" s
    for s in $(uci show network 2>/dev/null | sed -n "s/^network\.\([^.=]*\)=interface$/\1/p"); do
        [ "$(uci -q get network.$s.device)" = "$dev" ] && return 0
        # 兼容 ifname 写法（多设备空格分隔）
        case " $(uci -q get network.$s.ifname) " in
            *" $dev "*) return 0 ;;
        esac
    done
    return 1
}

# 找一个未被使用的接口名
pick_name() {
    local base="usbwan" n=1
    while uci -q get "network.$base" >/dev/null 2>&1; do
        n=$((n + 1))
        base="usbwan$n"
        [ "$n" -gt 9 ] && return 1
    done
    echo "$base"
}

# 把接口加入 wan 防火墙区域
add_to_wan_zone() {
    local name="$1" z
    z=$(uci show firewall 2>/dev/null | sed -n "s/^firewall\.@zone\[\([0-9]*\)\]\.name='wan'$/\1/p" | head -1)
    if [ -n "$z" ]; then
        uci add_list "firewall.@zone[$z].network=$name" 2>/dev/null
        return 0
    fi
    return 1
}

main() {
    local dev="" name="" created=0 changed=0

    # 参数优先（hotplug 传入），否则自行扫描
    if [ -n "$1" ]; then
        is_usb_net "$1" && dev="$1"
    else
        local d
        for d in /sys/class/net/*; do
            local n
            n=$(basename "$d")
            [ "$n" = "lo" ] && continue
            if is_usb_net "$n"; then
                dev="$n"
                break
            fi
        done
    fi

    if [ -z "$dev" ]; then
        log "未发现 USB 网卡（rndis_host/cdc_ether/cdc_ncm），跳过"
        return 0
    fi

    if dev_bound "$dev"; then
        log "$dev 已被现有接口占用，跳过"
        return 0
    fi

    name=$(pick_name) || { log "接口名已用尽"; return 1; }

    log "为 $dev 创建 DHCP 接口 $name"
    uci set "network.$name=interface"
    uci set "network.$name.proto=dhcp"
    uci set "network.$name.device=$dev"
    uci set "network.$name.metric=20"
    # 关掉 IPv6 自动协商，避免模块侧无 RA 时接口反复重试
    uci set "network.$name.ipv6=0" 2>/dev/null
    created=1

    if add_to_wan_zone "$name"; then
        uci commit firewall
        changed=1
    fi
    uci commit network

    if [ "$created" = "1" ]; then
        # 热插拔场景下 network 已运行时才 reload，避免开机阶段重复拉网
        [ -x /sbin/ubus ] && ubus call network reload 2>/dev/null
        [ "$changed" = "1" ] && /etc/init.d/firewall reload >/dev/null 2>&1
        log "已创建接口 $name（device=$dev, proto=dhcp, zone=wan）"
    fi
}

main "$@"
