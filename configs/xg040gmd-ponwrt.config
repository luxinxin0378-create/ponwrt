# PonWrt 配置片段 — Nokia XG-040G-MD (Airoha AN7581DT)
#
# 插件清单与已通过验证的 LEDE 固件完全一致，仅源码换成 PonWrt（ImmortalWrt 系）。
# workflow 流程：先写 target → defconfig → 锁设备 → 追加本文件 → defconfig。
# 因此这里只写"要什么"，依赖由 defconfig 推导。
#
# 设备符号（PonWrt 默认开启 TARGET_MULTI_PROFILE，格式必须有 DEVICE_）：
#   CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_nokia_xg-040g-md-ubi=y

# ===== 目标平台 =====
CONFIG_TARGET_airoha=y
CONFIG_TARGET_airoha_an7581=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y

# ===== 基础系统 =====
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y

# ===== 主题：Argon（ImmortalWrt 自带，支持深浅色切换）=====
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
# CONFIG_PACKAGE_luci-theme-material is not set

# ===== NPU / PPE 状态面板 =====
# 该包由上游 LedE luci 仓库移植，随 workflow 注入到 package/ 下编译
# 提供 NPU 状态、PPE(Frame Engine) 流程表、CPU 频率/超频控制
CONFIG_PACKAGE_luci-app-airoha-npu=y

# 必需：devmem applet（Frame Engine 寄存器读取 + CPU PLL 超频）
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_DEVMEM=y
CONFIG_BUSYBOX_DEFAULT_DEVMEM=y

# 必需：debugfs（PPE 流程表 /sys/kernel/debug/ppe/entries、NPU 时钟）
CONFIG_KERNEL_DEBUG_FS=y

# ===== CPU 频率调节 =====
CONFIG_PACKAGE_luci-app-cpufreq=y

# ===== 硬件加速：nftables flowtable offload =====
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-ipt-offload=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y

# ===== OpenClash（内核由 workflow 预置到 /etc/openclash/core）=====
CONFIG_PACKAGE_luci-app-openclash=y

# ===== QModem 4G/5G 模组管理（全功能）=====
# luci-app-qmodem 与 luci-app-qmodem-next 互斥，-next 为新版界面，短信/监控/多WAN 依赖它
# QMI 驱动：用内核通用驱动，避开 qmodem 默认的 vendor 驱动 kmod-qmi_wwan_q v1.2.9
#           （该版本 hrtimer_init 在内核 6.18 已移除，编译失败）
CONFIG_PACKAGE_qmodem_INCLUDE_generic-qmi-wwan=y
CONFIG_PACKAGE_qmodem=y
CONFIG_PACKAGE_qmodem-smsd=y
CONFIG_PACKAGE_libqmodem-sms=y
CONFIG_PACKAGE_luci-app-qmodem-next=y
# CONFIG_PACKAGE_luci-app-qmodem is not set

# --- 短信收发 + 转发 ---
CONFIG_PACKAGE_luci-app-qmodem-sms=y
CONFIG_PACKAGE_sms-forwarder-next=y

# --- 模组状态监控 ---
CONFIG_PACKAGE_qmodem_monitor=y
CONFIG_PACKAGE_luci-app-qmodem-monitor=y

# --- 多 WAN 负载均衡 ---
CONFIG_PACKAGE_luci-app-qmodem-mwan=y
CONFIG_PACKAGE_luci-app-mwan3=y

# --- TTL 修复/伪装 ---
CONFIG_PACKAGE_luci-app-qmodem-ttl=y
CONFIG_PACKAGE_luci-app-qmodem-ttlfw4=y

# --- 上行链路管理 ---
CONFIG_PACKAGE_qmodem-uplink-manager=y
CONFIG_PACKAGE_luci-app-qmodem-uplink=y

# --- VoIP 语音（含 SIP）---
CONFIG_PACKAGE_qmodem-voip=y
CONFIG_PACKAGE_qmodem-sipd=y
CONFIG_PACKAGE_luci-app-qmodem-voip=y

# --- 模组设置与 AT 守护 ---
CONFIG_PACKAGE_qmodem-settings=y
CONFIG_PACKAGE_tom_modem=y
CONFIG_PACKAGE_ubus-at-daemon=y

# --- 短信数据库 ---
CONFIG_PACKAGE_libsqlite3=y

# ===== USB 存储 =====
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y

# ===== USB 串口（模组 AT 口）=====
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-wwan=y
CONFIG_PACKAGE_kmod-usb-acm=y

# ===== USB 网卡（模组上网 / USB 网口）=====
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-wdm=y

# ===== 文件系统 =====
CONFIG_PACKAGE_kmod-fs-ext4=y
# 内核 6.18 已移除旧 NTFS 驱动（ntfs.ko），kmod-fs-ntfs 会编译失败，改用用户态 ntfs-3g
CONFIG_PACKAGE_ntfs-3g=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_usb-modeswitch=y
CONFIG_PACKAGE_usbutils=y

# ===== 常用工具 =====
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-app-ddns=y
